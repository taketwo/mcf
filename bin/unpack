#!/usr/bin/env bash

function print_help {
  echo "Usage: $0 [OPTIONS] [ARCHIVE_PATH]"
  echo ""
  echo "Unpack archive file(s) using the appropriate decompression tool."
  echo ""
  echo "Options:"
  echo "  -d, --delete         Delete the archive(s) after every archive unpacks successfully."
  echo "  -c, --clipboard      Unpack archive(s) listed in the clipboard, one path per line."
  echo "  -n, --no-top-dir     Move contents out of the top-level directory if the archive extracts into a single directory."
  echo "  -h, --help           Print this help message and exit."
}

function is_known_archive {
  case "$1" in
    *.tar.bz2 | *.tar.gz | *.tar.xz | *.tar.zst | *.tzst | *.bz2 | *.rar | *.gz | *.zst | *.tar | *.tbz2 | *.tgz | *.zip | *.Z | *.7z | *.deb)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# Extracts an archive if it has one of the known types.
function unpack {
  case "$1" in
    *.tar.bz2) tar xvjf "$1" ;;
    *.tar.gz) tar xvzf "$1" ;;
    *.tar.xz) tar xvJf "$1" ;;
    *.tar.zst | *.tzst) tar -I zstd -xvf "$1" ;;
    *.bz2) bunzip2 "$1" ;;
    *.rar) unrar x "$1" ;;
    *.gz) gunzip "$1" ;;
    *.zst) zstd -d "$1" ;;
    *.tar) tar xvf "$1" ;;
    *.tbz2) tar xvjf "$1" ;;
    *.tgz) tar xvzf "$1" ;;
    *.zip) unzip "$1" ;;
    *.Z) uncompress "$1" ;;
    *.7z) 7z x "$1" ;;
    *.deb) ar p "$1" data.tar.gz | tar zx ;;
    *)
      echo "Do not know how to extract '$1'..."
      exit 2
      ;;
  esac
}

# Flattens an archive that extracted as one new directory.
function flatten_top_dir {
  local files_before="$1"
  local files_after unpacked_files unpacked_files_count
  files_after=$(ls -1a)
  unpacked_files=$(comm -13 <(echo "$files_before") <(echo "$files_after"))
  unpacked_files_count=$(echo "$unpacked_files" | wc -l)
  if [ "$unpacked_files_count" -eq 1 ] && [ -d "$unpacked_files" ]; then
    echo "Moving contents of $unpacked_files to the current directory and removing $unpacked_files"
    mv "$unpacked_files"/* . && rmdir "$unpacked_files"
  fi
}

function read_clipboard_paths {
  local clipboard_text line
  if ! clipboard_text=$(xsel --clipboard --output); then
    echo "Error: failed to read the clipboard"
    exit 1
  fi
  local -n _paths="$1"
  while IFS= read -r line || [ -n "$line" ]; do
    if [ -z "$line" ]; then
      continue
    fi
    _paths+=("$line")
  done <<<"$clipboard_text"
}

# Parse command line options
ARGS=$(getopt -o dcnh -l delete,clipboard,no-top-dir,help -n "$0" -- "$@")
if [ $? != 0 ]; then
  echo "Error: Invalid arguments"
  print_help
  exit 1
fi

eval set -- "$ARGS"

while true; do
  case "$1" in
    -d | --delete)
      DELETE_ARCHIVE=true
      shift
      ;;
    -c | --clipboard)
      CLIPBOARD=true
      shift
      ;;
    -n | --no-top-dir)
      NO_TOP_DIR=true
      shift
      ;;
    -h | --help)
      print_help
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      echo "Error: Unknown option $1"
      print_help
      exit 1
      ;;
  esac
done

paths=()
if [ $# -gt 1 ]; then
  echo "Error: only one ARCHIVE_PATH can be provided"
  print_help
  exit 1
elif [ $# -eq 1 ]; then
  if [ -n "${CLIPBOARD}" ]; then
    echo "Error: cannot use both ARCHIVE_PATH and --clipboard options"
    print_help
    exit 1
  fi
  paths=("$1")
elif [ -n "${CLIPBOARD}" ]; then
  read_clipboard_paths paths
else
  echo "Error: no archive file path provided"
  print_help
  exit 1
fi

if [ "${#paths[@]}" -eq 0 ]; then
  echo "Error: no archive file path provided"
  print_help
  exit 1
fi

for path in "${paths[@]}"; do
  if [ ! -e "$path" ]; then
    echo "Error: ${path} does not exist"
    exit 1
  fi
  if [ ! -f "$path" ]; then
    echo "'${path}' is not a valid file!"
    exit 3
  fi
  if ! is_known_archive "$path"; then
    echo "Do not know how to extract '${path}'..."
    exit 2
  fi
done

for path in "${paths[@]}"; do
  files_before=$(ls -1a)
  unpack "$path"
  status=$?
  if [ "$status" -ne 0 ]; then
    exit "$status"
  fi
  if [ -n "${NO_TOP_DIR}" ]; then
    flatten_top_dir "$files_before" || exit $?
  fi
done

if [ -n "${DELETE_ARCHIVE}" ]; then
  if [ "${#paths[@]}" -eq 1 ]; then
    echo "Successfully unpacked, removing archive..."
  else
    echo "Successfully unpacked, removing archives..."
  fi
  rm -- "${paths[@]}"
fi
