# Show available commands
default:
    @just --list

# Set up development environment
setup:
    uv sync

# Pin ruff, tombi and ty to their latest releases
upgrade-checkers: && setup fix-format
    uv remove --dev --no-sync ruff tombi ty
    uv add --dev --bounds exact --no-sync ruff tombi ty

# Run all checks
check: check-format check-lint check-type

# Verify formatting
check-format: check-format-ruff check-format-tombi

# Verify Python formatting
check-format-ruff:
    .venv/bin/ruff format --check .

# Verify pyproject.toml formatting
check-format-tombi:
    .venv/bin/tombi format --check pyproject.toml

# Run linting checks
check-lint:
    .venv/bin/ruff check .

# Run type checking
check-type:
    .venv/bin/ty check src

# Auto-fix linting issues and auto-format code
fix: fix-lint fix-format

# Auto-format code
fix-format: fix-format-ruff fix-format-tombi

# Auto-format Python code
fix-format-ruff:
    .venv/bin/ruff format .

# Auto-format pyproject.toml
fix-format-tombi:
    .venv/bin/tombi format pyproject.toml

# Auto-fix linting issues
fix-lint:
    .venv/bin/ruff check --fix .

# Run all tests with coverage; extra args are passed through to pytest, e.g. just test -k lala
test *ARGS:
    .venv/bin/pytest --cov=src/{{ cookiecutter.package_name }} --cov-report=term-missing {% raw %}{{ARGS}}{% endraw %}

# Run the CLI application; extra args are passed through, e.g. just run --help
run *ARGS:
    .venv/bin/{{ cookiecutter.package_name }} {% raw %}{{ARGS}}{% endraw %}

