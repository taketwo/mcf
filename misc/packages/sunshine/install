#!/usr/bin/env bash

# shellcheck source=/dev/null
. /etc/os-release
PATTERN="sunshine_*+ubuntu${VERSION_ID}_amd64.deb"
TEMP_DEB=$(mktemp --suffix=.deb /tmp/sunshine.XXXXXX)

if ! gh release download --repo LizardByte/Sunshine --pattern "$PATTERN" -O "$TEMP_DEB" --clobber; then
  echo "Failed to download the latest release of Sunshine"
  exit 1
fi

sudo dpkg -i "$TEMP_DEB"
sudo apt --fix-broken install -y

systemctl --user daemon-reload
systemctl --user enable --now app-dev.lizardbyte.app.Sunshine.service
