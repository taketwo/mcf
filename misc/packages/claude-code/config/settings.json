{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ael catkin build:*)",
      "Bash(ael test:*)",
      "Bash(synctank create:*)",
      "Bash(synctank update:*)",
      "Bash(synctank list:*)",
      "Bash(synctank search:*)",
      "Bash(synctank lint:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "elements-of-style@superpowers-marketplace": true
  },
  "effortLevel": "xhigh",
  "theme": "dark-daltonized",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true
}
