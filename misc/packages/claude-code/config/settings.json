{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ael catkin build:*)",
      "Bash(ael test:*)",
      "Bash(synctank create:*)",
      "Bash(synctank update:*)",
      "Bash(synctank list:*)",
      "Bash(synctank search:*)",
      "Bash(synctank lint:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "elements-of-style@superpowers-marketplace": true
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "dark-daltonized",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true
}
