#!/usr/bin/env bash

if [[ $HOSTNAME == *"docker"* ]]; then
  echo "Not installing systemd timer and udev rules in Docker container"
else
  echo "Installing systemd timer..."
  systemctl --user daemon-reload
  systemctl --user enable mute-audio.timer
  systemctl --user start mute-audio.timer
  echo "Reloading udev rules..."
  sudo udevadm control --reload-rules
  # Copy, not symlink: AppArmor confines wg-quick to /etc/wireguard
  echo "Installing WireGuard configuration..."
  DIR=$(dirname "$(readlink -f "$0")")
  chmod 600 "$DIR/wg0.conf"
  sudo install -d -m 700 /etc/wireguard
  sudo rm -f /etc/wireguard/wg0.conf
  sudo install -m 600 -o root -g root "$DIR/wg0.conf" /etc/wireguard/wg0.conf
fi
